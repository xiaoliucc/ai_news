# AI Research Intelligence Platform 环境配置模板
# 复制为 .env（每台设备各维护一份，.env 不入 git）：
#   cp .env.example .env
# 未配置的值使用 backend/config.py 中的默认值。

# ── LLM（OpenAI 兼容端点）───────────────────────────────────────────────
# 模型与端点：DashScope（qwen-turbo）或 DeepSeek 等任意兼容端点
LLM_MODEL_ID=qwen-turbo
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# API key 按 base_url 自动匹配：base_url 含 "dashscope" → DASHSCOPE_API_KEY，
# 否则 → DEEPSEEK_API_KEY（可选 OPENAI_API_KEY 覆盖）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# LLM 请求超时（秒）
LLM_TIMEOUT=60

# ── Tavily 联网搜索（Agent web_search 工具）─────────────────────────────
# 查询采集库之外的实时信息（如"今天的最新动态"）；留空则工具返回"未配置"
TAVILY_API_KEY=

# ── 网络代理（墙外源：GitHub Trending / HuggingFace Papers）──────────────
# 填写本机代理地址则所有数据源走代理；留空 = 直连。
# 多设备各自填本机地址（Clash 默认 7890，v2ray 常见 10809）。
# 注意：系统环境变量已存在的 HTTPS_PROXY 优先于 .env。
# 修改后需重启后端生效（启动日志会打印当前网络模式）。
HTTPS_PROXY=

# ── Docker 部署（docker-compose.yml 读取，本机部署可选）──────────────────
# 容器内经宿主代理采集墙外源（容器内 127.0.0.1 指向自身，用 host.docker.internal
# 访问宿主；宿主 Clash 需开启 Allow LAN）；墙外部署留空 = 容器直连
DOCKER_HTTPS_PROXY=http://host.docker.internal:7890
# 嵌入模型缓存目录（容器挂载复用）；留空 = 项目 ./hf-cache 首次联网下载
# HF_CACHE_DIR=C:\Users\you\.cache\huggingface

# ── GitHub 采集主题（github.com/topics，按最近活跃排序）──────────────────
# 逗号分隔的 topic slug；留空用内置默认（llm, machine-learning, agent）。
# 这些页面作为 trending 的覆盖面补充，丰富"每天活跃"的 AI 仓库
# GITHUB_TOPICS=llm,machine-learning,agent,rag

# ── 内网穿透（cpolar 等隧道工具，前后端各一个隧道地址）──────────────────
# cpolar 一条隧道只能转发一个本地端口，需建两条：
#   后端隧道 → 本地 :8000（API），前端页面请求指向这里
#   前端隧道 → 本地 :5173（页面），后端 CORS 放行该 Origin
# 留空 = 直连/局域网（前后端互不依赖公网）。修改后需重启后端 + 重启 dev/重新 build。
# 注意：cpolar 免费版隧道重启后随机子域可能变化，域名变了需同步更新。
PUBLIC_BACKEND_URL=
PUBLIC_FRONTEND_URL=

# ── 嵌入模型 ─────────────────────────────────────────────────────────────
# 模型已本地缓存后置 1，禁止访问 huggingface.co（网络不可达时避免启动卡重试）
HF_HUB_OFFLINE=1

# ── 中文源 RSS（免费额度：60 分钟/次、每日 25 次、单次 10 条）─────────────
# 逗号分隔的 feed URL 列表，如机器之心官方 RSS
RSS_FEEDS=

# ── 数据存储与采集（默认值即可）──────────────────────────────────────────
# SQLITE_PATH=backend/db/data.db
# CHROMA_DIR=backend/db/chroma
# COLLECTION_LIMIT=20
# COLLECTION_HOURS=6
